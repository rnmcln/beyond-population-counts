.DS_Store
.env
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*.egg-info/

# Source data are downloaded, not versioned.
data/raw/**
data/interim/**
data/processed/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Generated results.
outputs/**
!outputs/tables/.gitkeep
!outputs/figures/.gitkeep
!outputs/logs/.gitkeep
